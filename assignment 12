#include <iostream>
using namespace std;

namespace ns1
{
    int value()
    {
        return 5;
    }
}

namespace ns2
{
    const double x = 100;

    double value()
    {
        return 2 * x;
    }
}

int main()
{
    cout << "Value from ns1: " << ns1::value() << endl;
    cout << "Value from ns2: " << ns2::value() << endl;
    cout << "Value of x: " << ns2::x << endl;

    return 0;
}
